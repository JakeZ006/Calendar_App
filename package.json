{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "vue-tsc --noEmit",
        "format": "npm run pint && npm run stylelint && npm run prettier",
        "pint": "./vendor/bin/pint",
        "stylelint": "npx stylelint 'resources/**/*.{css,vue}' --fix",
        "prettier": "prettier --write --experimental-cli resources/"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@lucide/vue": "^1.66.0",
        "@tailwindcss/vite": "^4.1.11",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vueuse/components": "^15.0.0",
        "@vueuse/core": "^15.0.0",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.2.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vue": "^3.5.13",
        "vue-dragscroll": "^4.0.6"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@types/node": "^22.13.5",
        "postcss-html": "^2.0.0",
        "prettier": "^3.10.1",
        "prettier-plugin-organize-attributes": "^1.0.0",
        "sass-embedded": "^1.107.0",
        "stylelint": "^18.0.0",
        "stylelint-config-clean-order": "^10.0.0",
        "stylelint-config-html": "^2.0.0",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard": "^41.0.0",
        "stylelint-config-standard-scss": "^18.0.0",
        "stylelint-config-standard-vue": "^2.0.0",
        "stylelint-order": "^8.1.3",
        "vite-plus": "1.4.0",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    }
}
